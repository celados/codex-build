+    #[default]
+    ObserveOnly,
+    ResumeTurn,
+}
+
+#[derive(Debug)]
+struct BackgroundCompletionDelivery {
+    policy: BackgroundCompletionPolicy,
+    initial_call_active: AtomicBool,
+    initial_call_finished: Notify,
+    claim: AtomicU8,
+}
+
+impl BackgroundCompletionDelivery {
+    fn new(policy: BackgroundCompletionPolicy) -> Self {
+        Self {
+            policy,
+            initial_call_active: AtomicBool::new(true),
+            initial_call_finished: Notify::new(),
+            claim: AtomicU8::new(COMPLETION_UNCLAIMED),
+        }
+    }
