+const COMPLETION_FOREGROUND: u8 = 1;
+const COMPLETION_BACKGROUND: u8 = 2;
+const COMPLETION_SUPPRESSED: u8 = 3;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum ForegroundCompletionClaim {
+    Acquired,
+    BackgroundAlreadyDelivered,
+    Unavailable,
+}
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum BackgroundCompletionPolicy {
+    #[default]
+    ObserveOnly,
+    ResumeTurn,
+}
+
+#[derive(Debug)]
+struct BackgroundCompletionDelivery {
+    policy: BackgroundCompletionPolicy,
+    initial_call_active: AtomicBool,
+    initial_call_finished: Notify,
+    claim: AtomicU8,
+}
+
+impl BackgroundCompletionDelivery {
+    fn new(policy: BackgroundCompletionPolicy) -> Self {
+        Self {
+            policy,
+            initial_call_active: AtomicBool::new(true),
+            initial_call_finished: Notify::new(),
+            claim: AtomicU8::new(COMPLETION_UNCLAIMED),
+        }
+    }
+
+    fn finish_initial_call(&self) {
+        self.initial_call_active.store(false, Ordering::Release);
+        self.initial_call_finished.notify_waiters();
+    }
+
+    fn initial_call_is_active(&self) -> bool {
+        self.initial_call_active.load(Ordering::Acquire)
+    }
+
+    fn claim_foreground(&self) -> ForegroundCompletionClaim {
+        match self.claim.compare_exchange(
+            COMPLETION_UNCLAIMED,
+            COMPLETION_FOREGROUND,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        ) {
+            Ok(_) => ForegroundCompletionClaim::Acquired,
+            Err(COMPLETION_BACKGROUND) => ForegroundCompletionClaim::BackgroundAlreadyDelivered,
+            Err(_) => ForegroundCompletionClaim::Unavailable,
+        }
+    }
+
+    async fn claim_background(&self) -> bool {
+        if self.policy != BackgroundCompletionPolicy::ResumeTurn {
+            return false;
+        }
+
+        loop {
+            if self.claim.load(Ordering::Acquire) != COMPLETION_UNCLAIMED {
+                return false;
+            }
+            if !self.initial_call_is_active() {
+                break;
+            }
+            // Register before checking again so a concurrent guard drop cannot lose the wakeup.
+            let initial_call_finished = self.initial_call_finished.notified();
